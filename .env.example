OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Recommended free-provider mode: Gemini Developer API through its OpenAI-compatible endpoint.
# Alternatives:
# Groq: LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# Optional fallback provider. Cohere supports the OpenAI-compatible endpoint below.
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=command-a-03-2025

# Optional production storage. The MVP runs without these by using local JSON files.
# When set, documents are also read from the ansem_documents table (see supabase/schema.sql)
# and merged with data/ansem-config.json. Push local docs there with `npm run supabase:migrate`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=

# Optional free/public endpoints can be overridden.
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest/dex
SOLSCAN_BASE_URL=https://public-api.solscan.io

# Holder/supply data (lib/chain-data.ts) works with zero config using Solana's public RPC,
# but that endpoint hard rate-limits getTokenLargestAccounts. For reliable holder answers,
# sign up for a free Helius account (https://www.helius.dev, free tier: 1M credits/mo, no card)
# and set ONE of the following:
HELIUS_API_KEY=
SOLANA_RPC_URL=
